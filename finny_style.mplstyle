figure.dpi: 100
figure.figsize: 10, 6

axes.titlesize: 16
axes.labelsize: 14
axes.linewidth: 1.5
axes.grid: True
axes.grid.which: both
grid.alpha: 0.3
grid.linestyle: --

xtick.labelsize: 12
ytick.labelsize: 12
xtick.major.width: 1.5
ytick.major.width: 1.5
xtick.minor.width: 1
ytick.minor.width: 1

axes.labelweight: bold
axes.titleweight: bold

legend.fontsize: 12
legend.loc: best
legend.frameon: True
legend.edgecolor: black
legend.facecolor: none

font.family: sans-serif
font.serif: Helvetica
mathtext.fontset: stix

axes.prop_cycle: cycler('color', ['1f77b4', 'd62728', '2ca02c', 'ff7f0e', '9467bd', 'e377c2', 'bcbd22', '17becf', '8c564b', 'e377c2', '7f7f7f', 'a133ff', 'ff33a1', 'ffbb33', '57ff33', '33ffa1',])